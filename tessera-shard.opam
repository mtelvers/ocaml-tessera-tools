# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Live Zarr shards and sub-windows of a region"
description:
  "tessera-tiles for the Zarr store: reads World Bank (or any OGR) region polygons and lists the shards and sub-windows of a seeded zone grid they cover"
maintainer: ["Mark Elvers <mark.elvers@tunbury.org>"]
authors: ["Mark Elvers <mark.elvers@tunbury.org>"]
license: "MIT"
homepage: "https://github.com/mtelvers/ocaml-tessera-tools"
bug-reports: "https://github.com/mtelvers/ocaml-tessera-tools/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.0" & >= "3.0"}
  "tessera-grid"
  "gdal"
  "stac_client"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mtelvers/ocaml-tessera-tools.git"
