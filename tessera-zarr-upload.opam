opam-version: "2.0"
synopsis: "Place Tessera encoder output into an S3 Zarr store"
description:
  "Assembles Zarr v3 shards from .npy embedding tiles or windows and uploads them to the geotessera store layout on S3"
maintainer: ["Mark Elvers <mark.elvers@tunbury.org>"]
authors: ["Mark Elvers <mark.elvers@tunbury.org>"]
license: "MIT"
homepage: "https://github.com/mtelvers/ocaml-tessera-tools"
bug-reports: "https://github.com/mtelvers/ocaml-tessera-tools/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.0" & >= "3.0"}
  "gdal"
  "stac_client"
  "npy"
  "zarr"
  "zarr-blosc"
  "zarr-s3"
  "s3"
  "eio" {>= "1.0"}
  "eio_main"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mtelvers/ocaml-tessera-tools.git"
