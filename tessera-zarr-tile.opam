# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Cut 0.1 degree .npy tiles out of an S3 Zarr store"
description:
  "The inverse of tessera-zarr-upload: reads the window of the zone grid that a grid_<lon>_<lat> tile occupies, through partial shard reads, and writes the archive's .npy pair and SHA256 sidecar"
maintainer: ["Mark Elvers <mark.elvers@tunbury.org>"]
authors: ["Mark Elvers <mark.elvers@tunbury.org>"]
license: "MIT"
homepage: "https://github.com/mtelvers/ocaml-tessera-tools"
bug-reports: "https://github.com/mtelvers/ocaml-tessera-tools/issues"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.0" & >= "3.0"}
  "gdal"
  "stac_client"
  "npy"
  "zarr"
  "zarr-blosc"
  "zarr-s3"
  "s3"
  "digestif"
  "eio" {>= "1.0"}
  "eio_main"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/mtelvers/ocaml-tessera-tools.git"
